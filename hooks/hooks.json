{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/tidy.py\" hook-register" }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/tidy.py\" hook-session-end" }]
      }
    ]
  }
}
